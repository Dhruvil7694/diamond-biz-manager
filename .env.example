# Local PostgreSQL REST API (server/index.mjs)
# If the password contains # @ : / ? % or spaces, percent-encode it in the URL
# (e.g. my#pass → my%23pass). PowerShell: [System.Uri]::EscapeDataString('your password')
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/diamond
API_PORT=3333

# JWT signing secret for login tokens (use a long random string in production).
JWT_SECRET=change-me-to-a-long-random-secret-in-production

# Vite: leave empty to use same-origin /api (dev proxy → API). Set full URL in production if API is on another host.
# VITE_API_URL=

# Optional: legacy demo login still reads this (not used by PostgreSQL API).
# VITE_SUPABASE_ACCESS_TOKEN=
